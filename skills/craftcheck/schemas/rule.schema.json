{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "domain",
    "kind",
    "description",
    "guidance",
    "appliesTo",
    "verification",
    "counterexamples",
    "sourceIds",
    "automation"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z]+[0-9]{2}$"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "domain": {
      "enum": [
        "accessibility",
        "ux",
        "copy",
        "performance",
        "security",
        "engineering",
        "design",
        "media",
        "rights",
        "devex"
      ]
    },
    "kind": {
      "enum": [
        "requirement",
        "heuristic",
        "option",
        "definition"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 2000
    },
    "guidance": {
      "type": "string",
      "minLength": 10,
      "maxLength": 2000
    },
    "appliesTo": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "all",
          "web",
          "code",
          "backend",
          "document",
          "media"
        ]
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 10,
        "maxLength": 2000
      }
    },
    "counterexamples": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 10,
        "maxLength": 2000
      }
    },
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 100
      }
    },
    "automation": {
      "enum": [
        "none",
        "partial",
        "static"
      ]
    },
    "defaultSeverity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "suggestion"
      ]
    },
    "original": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "item"
      ],
      "properties": {
        "image": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "item": {
          "type": "integer",
          "minimum": 1,
          "maximum": 22
        }
      }
    }
  }
}
