    {
      "id": "stress-journeys",
      "title": "Adverse customer journeys",
      "items": [
        {
          "id": "stress-journeys-01",
          "label": "Go back during checkout",
          "ruleIds": [
            "UX06",
            "S11"
          ],
          "scenario": "Return with browser Back, refresh and retry. Confirm one pending checkout and no duplicate charge; final completion comes from an owner-verified server/provider result."
        },
        {
          "id": "stress-journeys-02",
          "label": "Emoji in username",
          "ruleIds": [
            "UX09",
            "E07"
          ],
          "scenario": "Save, reload and display a Unicode username without HTML execution, broken encoding or clipping."
        },
        {
          "id": "stress-journeys-03",
          "label": "Very long profile text",
          "ruleIds": [
            "UX09",
            "UX13"
          ],
          "scenario": "Submit oversized text; the server rejects or bounds it and the UI wraps it without losing actions or pretending to save."
        },
        {
          "id": "stress-journeys-04",
          "label": "Upload while offline",
          "ruleIds": [
            "UX04",
            "UX06",
            "S34"
          ],
          "scenario": "Disconnect during upload, reconnect and retry. Show an error and retain the draft; reject incomplete files and avoid duplicate paid work."
        },
        {
          "id": "stress-journeys-05",
          "label": "Rotate the device",
          "ruleIds": [
            "UX13"
          ],
          "scenario": "Rotate while a menu, keyboard or dialog is open. Keep the focused field and primary actions visible."
        },
        {
          "id": "stress-journeys-06",
          "label": "Increase font size",
          "ruleIds": [
            "A05",
            "UX13"
          ],
          "scenario": "Test 200% text size and narrow reflow, with no clipped labels, loss of content or inaccessible controls."
        },
        {
          "id": "stress-journeys-07",
          "label": "Switch color preference",
          "ruleIds": [
            "D14",
            "A07"
          ],
          "scenario": "Change the saved and OS preferences. Honor the supported theme contract and retain readable text, focus and controls."
        },
        {
          "id": "stress-journeys-08",
          "label": "Register twice",
          "ruleIds": [
            "UX10",
            "S28"
          ],
          "scenario": "Submit the same address twice and retry rapidly. Avoid duplicate identity/credit grants and account-enumerating errors."
        },
        {
          "id": "stress-journeys-09",
          "label": "Submit a blank email",
          "ruleIds": [
            "A03",
            "E07"
          ],
          "scenario": "Test empty, whitespace-only and invalid addresses. Show a field error and refuse invalid server requests."
        },
        {
          "id": "stress-journeys-10",
          "label": "Use spaces in a password",
          "ruleIds": [
            "S05",
            "E07"
          ],
          "scenario": "Preserve the exact password, including leading and trailing spaces, across registration, login and recovery; do not silently trim it."
        },
        {
          "id": "stress-journeys-11",
          "label": "Change foldable viewport dimensions",
          "ruleIds": [
            "UX13"
          ],
          "scenario": "Resize between folded, unfolded, narrow and split-screen widths during the same task; preserve entered state and reachable controls."
        },
        {
          "id": "stress-journeys-12",
          "label": "Deny permissions",
          "ruleIds": [
            "UX05",
            "UX04"
          ],
          "scenario": "Deny and revoke microphone/camera permission. Stop capture, explain recovery and leave the ordinary input path usable."
        },
        {
          "id": "stress-journeys-13",
          "label": "Use a private relay email",
          "ruleIds": [
            "S28",
            "UX10"
          ],
          "scenario": "Register, confirm, recover and receive transactional mail with a relay address; do not require the user's underlying address."
        },
        {
          "id": "stress-journeys-14",
          "label": "Leave onboarding midway",
          "ruleIds": [
            "UX08",
            "UX10"
          ],
          "scenario": "Leave, reload and resume onboarding without creating duplicate accounts or losing an already-saved choice."
        },
        {
          "id": "stress-journeys-15",
          "label": "Change timezone",
          "ruleIds": [
            "UX09",
            "E07"
          ],
          "scenario": "Change timezone and locale; preserve event instants, billing periods and stable sort order without duplicate scheduled work."
        },
        {
          "id": "stress-journeys-16",
          "label": "Use Arabic and RTL",
          "ruleIds": [
            "UX09",
            "UX13"
          ],
          "scenario": "Test Arabic text, bidirectional email/IDs and long translated labels on mobile; retain focus order and correct directional icons."
        },
        {
          "id": "stress-journeys-17",
          "label": "Use a slow connection",
          "ruleIds": [
            "UX04",
            "F06"
          ],
          "scenario": "Throttle or delay requests. Keep pending feedback, prevent duplicate mutation submission, and expose retry after a failure."
        },
        {
          "id": "stress-journeys-18",
          "label": "Delete an account then register again",
          "ruleIds": [
            "UX10",
            "S28",
            "S32"
          ],
          "scenario": "Verify deletion, session revocation, upload cleanup and retained fiscal records separately; do not grant repeat free entitlements accidentally."
        },
        {
          "id": "stress-journeys-19",
          "label": "Use two devices",
          "ruleIds": [
            "UX05",
            "S11",
            "S28"
          ],
          "scenario": "Change/deactivate an account on one device and use a stale session on the other; reauthorize server mutations and reconcile balances atomically."
        }
      ]
    },
