{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/JonathanStecher/sloppyai/schemas/config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "domains": { "type": "array", "uniqueItems": true, "minItems": 1, "items": { "enum": ["accessibility", "ux", "copy", "performance", "security", "engineering", "design", "media", "rights", "devex"] } },
    "language": { "type": "string", "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$" },
    "htmlMode": { "enum": ["auto", "document", "fragment"] },
    "maxFiles": { "type": "integer", "minimum": 1, "maximum": 20000 },
    "maxFileBytes": { "type": "integer", "minimum": 100, "maximum": 10000000 },
    "maxTotalBytes": { "type": "integer", "minimum": 100, "maximum": 200000000 },
    "exclude": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\\\*?\u0000]+$" } },
    "acceptedHeuristics": {
      "type": "array", "maxItems": 100,
      "items": { "type": "object", "additionalProperties": false, "required": ["ruleId", "reason"], "properties": { "ruleId": { "type": "string", "maxLength": 80 }, "reason": { "type": "string", "minLength": 10, "maxLength": 1000 } } }
    },
    "preserve": {
      "type": "array", "maxItems": 100,
      "items": { "type": "object", "additionalProperties": false, "required": ["path", "contains"], "properties": { "path": { "type": "string", "minLength": 1, "maxLength": 500 }, "contains": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } } } }
    },
    "checks": { "type": "array", "maxItems": 12, "items": { "$ref": "#/definitions/command" } },
    "fixer": { "$ref": "#/definitions/command" },
    "reviewer": { "$ref": "#/definitions/command" },
    "loop": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "maxRounds": { "type": "integer", "minimum": 1, "maximum": 20 },
        "targetScore": { "type": "number", "minimum": 0, "maximum": 100 },
        "reviewTarget": { "type": "number", "minimum": 0, "maximum": 5 },
        "stallRounds": { "type": "integer", "minimum": 1, "maximum": 5 },
        "maxDurationMs": { "type": "integer", "minimum": 100, "maximum": 1800000 }
      }
    }
  },
  "definitions": {
    "command": {
      "type": "object", "additionalProperties": false, "required": ["name", "command"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "command": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 4000 } },
        "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 300000 },
        "attempts": { "type": "integer", "minimum": 1, "maximum": 3 }
      }
    }
  }
}
